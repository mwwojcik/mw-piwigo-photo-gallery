/* Maksymalne przyciemnienie i stonowanie nagłówka */
.navbar-default, .navbar, .nav {
    background-color: #222222 !important; /* Bardzo ciemne, matowe tło */
    border: none !important;              /* Usunięcie jasnych ramek/linii */
    box-shadow: none !important;          /* Usunięcie cieni rzucanych przez menu */
}

/* Stonowanie linków i tekstu w nagłówku, żeby nie "świeciły" po oczach */
.navbar-default .navbar-nav > li > a, 
.navbar-brand {
    color: #888888 !important; /* Szary, dyskretny kolor tekstu */
}

/* Delikatne rozjaśnienie tekstu dopiero po najechaniu myszką */
.navbar-default .navbar-nav > li > a:hover, 
.navbar-brand:hover {
    color: #cccccc !important; 
}

.copyright {
    display: none !important;
}



.mw-home {
  background: #111416;
  color: #d8d2c8;
  margin-bottom: 5rem;
}

.mw-home img {
  display: block;
  max-width: 100%;
}

.mw-hero {
  min-height: 82vh;
  background-size: cover;
  background-position: center;
  position: relative;
}

.mw-hero-overlay {
  min-height: 82vh;
  display: flex;
  align-items: center;
  background:
    linear-gradient(
      to right,
      rgba(7, 9, 10, .82),
      rgba(7, 9, 10, .35),
      rgba(7, 9, 10, .15)
    ),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, .15),
      rgba(17, 20, 22, .9)
    );
}

.mw-hero-content {
  width: min(1180px, calc(100% - 4rem));
  margin: 0 auto;
  padding-top: 5rem;
}

.mw-hero h1 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: 1;
  font-weight: 300;
  letter-spacing: .02em;
  color: #f3eee5;
  margin: 0;
}

.mw-hero-line {
  width: 140px;
  height: 1px;
  background: #c69a53;
  margin: 1.6rem 0 1.6rem;
}

.mw-hero p {
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
  font-size: clamp(1.25rem, 2.1vw, 2rem);
  line-height: 1.45;
  color: #e2d8ca;
  margin: 0;
}

.mw-scroll {
  display: inline-block;
  margin-top: 4rem;
  color: #c69a53;
  font-size: 3rem;
  line-height: 1;
  text-decoration: none;
  font-weight: 200;
}

.mw-scroll:hover {
  color: #fff;
  text-decoration: none;
}

.mw-section {
  width: min(1180px, calc(100% - 4rem));
  margin: 0 auto;
}

.mw-powroty {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 5rem;
  align-items: center;
  padding: 5rem 0 4rem;
}

.mw-powroty h2,
.mw-najbardziej h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1rem;
  line-height: 1.65;
  text-transform: uppercase;
  letter-spacing: .36em;
  font-weight: 400;
  color: #c69a53;
  margin: 0 0 2rem;
}

.mw-powroty h2::after,
.mw-najbardziej h2::after {
  content: "";
  display: block;
  width: 76px;
  height: 1px;
  background: #c69a53;
  margin-top: 1.1rem;
}

.mw-powroty p {
  font-size: 1rem;
  line-height: 1.85;
  color: #d2d2d2;
  margin: 0 0 1.35rem;
}

.mw-powroty-image img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  filter: brightness(.88);
}

.mw-najbardziej {
  padding: 2rem 0 6rem;
  text-align: center;
}

.mw-najbardziej h2::after {
  margin-left: auto;
  margin-right: auto;
}

.mw-choice-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.mw-choice-grid a {
  overflow: hidden;
  background: #000;
}

.mw-choice-grid img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  filter: brightness(.82) saturate(.92);
  transition: transform .35s ease, filter .35s ease;
}

.mw-choice-grid a:hover img {
  transform: scale(1.025);
  filter: brightness(1.05) saturate(1);
}

.mw-choice-more {
  margin-top: 2rem;
}

.mw-choice-more a {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  border: 1px solid rgba(198,154,83,.55);
  padding: .85rem 1.8rem;
  color: #c69a53;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: .22em;
  font-size: .75rem;
  transition: .25s ease;
}

.mw-choice-more a:hover {
  color: #fff;
  border-color: #fff;
  text-decoration: none;
}

.mw-choice-more span {
  font-size: 1rem;
}

@media (max-width: 900px) {
  .mw-hero-content,
  .mw-section {
    width: min(100% - 2rem, 1180px);
  }

  .mw-powroty {
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-top: 4rem;
  }

  .mw-powroty-text {
    max-width: 720px;
  }

  .mw-choice-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .mw-hero {
    min-height: 72vh;
  }

  .mw-hero-overlay {
    min-height: 72vh;
  }

  .mw-hero-content {
    padding-top: 3rem;
  }

  .mw-powroty h2,
  .mw-najbardziej h2 {
    letter-spacing: .24em;
  }

  .mw-choice-grid {
    gap: 8px;
  }
}